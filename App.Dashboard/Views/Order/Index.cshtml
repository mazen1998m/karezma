@using App.Domain.Enums
@using App.Domain.Orders
@using App.Domain.Orders.Dtos
@using App.core.Extensions
@using App.core.Muslim.Result
<link href="~/pagescss/permission/permissionindex.css" rel="stylesheet" />
<link href="~/pagescss/css/public.css" rel="stylesheet" />
<link href="~/pagescss/css/pagination.css" rel="stylesheet" />
<link href="~/pagescss/css/popup.css" rel="stylesheet" />

@model Result<List<ListOrderDto>>
@{
    var data = Model.Response;
    var Page = Model.Response.Count==0 ? new() : Model.Page;
    var filter = Model.Filter as OrderFilter;
}
<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <h1 class="h3 mb-0 text-gray-800">

            <i class="fa-regular fa-rectangle-list" style="color:#502e90;"></i>
            <span data-arabic="إدارة الطلبات"
                  data-english="Order Managment"></span>

        </h1>
        @* <div>
            <a href="#">
                <i id="infoBtn" class="fa fa-info-circle" style="color:#502e90;"></i>
            </a>
            <div id="infoPopup">all</div>
        </div> *@
    </div>

    <form asp-action="Index" method="get" id="searchForm">
        <div class="row" style="margin-left: 20px; margin: 10px;">

            <div class="col-2 ">
                <input name="ClintPhone"
                       class="form-control form-control-lg" 
                       type="text"
                       placeholder-ar="هاتف العميل"
                       placeholder-en="Clint Phone"
                       aria-label="Clint Phone"
                       style="border-radius: 17px; border: none;"
                       value="@filter.ClintPhone">
            </div>
            <div class="col-2 ">
                <input name="Barcode"
                       class="form-control form-control-lg" 
                       type="text" 
                       placeholder-ar="الباركود"
                       placeholder-en="Barcode"
                       aria-label="Barcode"
                       style="border-radius: 17px; border: none;"
                       value="@filter.Barcode">
            </div>
            
            <div class="col-2 ">
                <select name="Status"
                        class="form-control form-control-lg"
                        aria-label="Status"
                        style="border-radius: 17px; border: none;">
                    <option value=""
                            selected="@(filter.Status == OrderStatus.non)"
                            data-arabic="كل الحالات"
                            data-english="All Status"></option>
                    <option value="@OrderStatus.Pending"
                            selected="@(filter.Status == OrderStatus.Pending)"
                            data-arabic="قيد الانتظار"
                            data-english="Pending">Pending</option>
                    <option value="@OrderStatus.Accept"
                            selected="@(filter.Status == OrderStatus.Accept)"
                            data-arabic="مقبول"
                            data-english="Accepted">Accept</option>
                    <option value="@OrderStatus.Reject"
                            selected="@(filter.Status == OrderStatus.Reject)"
                            data-arabic="مرفوض"
                            data-english="Rejected">Reject</option>
                    <option value="@OrderStatus.Delivered"
                            selected="@(filter.Status == OrderStatus.Delivered)"
                            data-arabic="تم التوصيل"
                            data-english="Delivered">Delivered</option>
                    <option value="@OrderStatus.Revoke"
                            selected="@(filter.Status == OrderStatus.Revoke)"
                            data-arabic="مرتجع"
                            data-english="Revoke">Revoke</option>
                    <option value="@OrderStatus.Paid"
                            selected="@(filter.Status == OrderStatus.Paid)"
                            data-arabic="مدفوع"
                            data-english="Paid">Paid</option>
                </select>

            </div>
            <div class="col-2 ">
                <input name="FromDate"
                       class="form-control form-control-lg"
                       type="date"
                       placeholder-ar="من تاريخ"
                       placeholder-en="FromDate"
                       aria-label="FromDate"
                       style="border-radius: 17px; border: none;"
                       value="@filter.FromDate"
                >
            </div>

            <div class="col-2 ">
                <input name="ToDate"
                       class="form-control form-control-lg"
                       type="date"
                       placeholder-ar="إلى تاريخ"
                       placeholder-en="ToDate"
                       aria-label="ToDate"
                       style="border-radius: 17px; border: none;"
                       value="@filter.ToDate"
                >
            </div>

            <input type="hidden" name="PageIndex" id="pageIndex" value="1">


            <div class="col-2 ">

                <button onclick="updatePageIndex(@ViewBag.LastIndex)" class="btn btn-lg new"
                        style="border:2px solid #502e90; color: white;width:150px; border-radius:20px ; padding-left: 35px ; padding-right: 35px;">
                    <span data-arabic="بحث" data-english="Search">
                        
                    </span>
                </button>

                <button type="submit" hidden></button>
                <a asp-action="Index" title="Back to full list"><i class="fa-solid fa-circle-chevron-left fa-xl" style="color:#502e90"></i></a>
            </div>

            <!-- Force next columns to break to new line at md breakpoint and up -->

        </div>
    </form>

</div>
<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- DataTales Example -->
    <div class="card-body ">
        <div class="table-responsive shadow mb-4"
             style="background-color: white; border-radius: 17px; ">
            <table class="table table-bordered " id="dataTable" width="100%" cellspacing="0"
                   style="border: 0px;" >
                <thead>
                    <tr>
                        <th data-arabic="رقم الطلب" data-english="Order_Id"></th>
                        <th data-arabic="إسم المندوب" data-english="Salesman Name"></th>
                        <th data-arabic="إسم الزبون" data-english="Customer Name"></th>
                        <th data-arabic="رقم الهاتف" data-english="Phone Number"></th>
                        <th data-arabic="العنوان" data-english="Address"></th>
                        <th data-arabic="الكمية" data-english="Quantity"></th>
                        <th data-arabic="السعر الكلي" data-english="Total Price"></th>
                        <th data-arabic="الحالة" data-english="Status"></th>
                        <th data-arabic="التاريخ" data-english="Date"></th>
                        <th data-arabic="عرض التفاصيل" data-english="View Details"></th>
                    </tr>
                </thead>

                <tbody >
                    @if (Model is not null)
                    {


                        @if (data.Count > 0 && data != null)
                        {

                            @foreach (var item in data)
                            {

                                <tr>
                                   
                                    <td>@item.Id</td>
                                    <td>@item.RepresentativeName</td>
                                    <td>@item.Clint.Name</td>
                                    <td>@item.Clint.Phone</td>
                                    <td>@item.Address</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.Price</td>
                                    <td>
                                        @switch (@item.OrderStatus.ToEnum<OrderStatus>())
                                        {
                                            case OrderStatus.Pending:
                                                <span style=" color: #f6c23e; border-radius: 10px; padding:5px;"
                                                    data-arabic="قيد الانتظار" 
                                                    data-english="Pending"></span>
                                                break;
                                            case OrderStatus.Accept:
                                                <span 
                                                    style="color: #1cc88a;  border-radius: 10px; padding:5px;"
                                                    data-arabic="مقبول"
                                                    data-english="Accepted"></span>
                                                break;
                                            case OrderStatus.Reject:
                                                <span style="color: #e74a3b;  border-radius: 10px; padding:5px;"
                                                    data-arabic="مرفوض"
                                                    data-english="Rejected"></span>
                                                break;
                                            case OrderStatus.Delivered:
                                                <span style="color: #36b9cc; border-radius: 10px; padding:5px;"
                                                    data-arabic="تم التوصيل"
                                                    data-english="Delivered"></span>
                                                break;
                                            case OrderStatus.Revoke:
                                                <span style="color: #e74a3b;  border-radius: 10px; padding:5px;"
                                                    data-arabic="مرتجع"
                                                    data-english="Revoke"></span>
                                                break;
                                            case OrderStatus.Paid:
                                                <span style=" color:#1cc88a;  border-radius: 10px; padding:5px;"
                                                    data-arabic="مدفوع"
                                                    data-english="Paid"></span>
                                                break;
                                            default:
                                                break;
                                            
                                        
                                        }

                                    </td>
                                    <td>@item.CreatedDate.ToString("dd-MM-yyyy")</td>
                                  
                                    <td>
                                        <span style="margin: 10px;">
                                            <a asp-action="Details" asp-route-id="@item.Id">
                                                <i class="fa fa-info-circle" style="color:#502e90;"></i>

                                            </a>
                                        </span>
                                    </td>
                                </tr>
                                
                            }

                        }
                        else
                        {
                            <tr style="text-align:center">
                                <td colspan="5" style="font-size:20px;font-style:italic">No Data</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr style="text-align:center">
                            <td colspan="5" style="font-size:20px;font-style:italic">No Data</td>
                        </tr>
                    }

                </tbody>


            </table>
            @if (Model is not null)
            {
                <form method="get" asp-action="Index">


                    <input hidden readonly type="number" id="pagenumber" name="pageIndex" value="@filter.PageIndex" />
                    <input readonly hidden type="number" id="currentPage" min="1" value="1">
                    
                    <input readonly hidden name="Status" value="@filter.Status">
                    <input readonly hidden name="FromDate" value="@filter.FromDate">
                    <input readonly hidden name="ToDate" value="@filter.ToDate">
                    <input readonly hidden name="ClintPhone" value="@filter.ClintPhone">
                    <input readonly hidden name="Barcode" value="@filter.Barcode">

                    <div class="pagination" id="pagination">

                        <input hidden readonly type="number" oninput="generatePagination()" id="totalPages" min="1" value="@Page.NumberOfPages">
                    </div>
                </form>


            }
        </div>
    </div>

</div>
@{
    bool inputCondition = ViewBag.Action; // Assuming ViewBag.Action is a boolean value
}

@if (inputCondition == true)
{
    <script src="~/pagesjs/layout/toastmessagejs.js"></script>
}
<script src="~/pagesjs/permission/permissionindex.js"></script> 
<script src="~/pagesjs/publicjs/public.js"></script>
<script src="~/pagesjs/pagination/paginationjs.js"></script>
<script src="~/pagesjs/publicjs/popup.js"></script>
