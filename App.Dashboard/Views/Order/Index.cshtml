@using App.Domain.Representatives.Dtos
<link href="~/pagescss/permission/permissionindex.css" rel="stylesheet" />
<link href="~/pagescss/css/public.css" rel="stylesheet" />
<link href="~/pagescss/css/pagination.css" rel="stylesheet" />
<link href="~/pagescss/css/popup.css" rel="stylesheet" />

@model Muslim.HandelResult.Result<List<ListRepresentativeDto>>
@{
    var data = Model.Response;
    var Page = Model.Response.Count==0 ? new() : Model.Page;
    var pagenumber = ViewBag.Pageindex;
}
<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <h1 class="h3 mb-0 text-gray-800">

            <i class="fa-regular fa-rectangle-list" style="color:#502e90;"></i>
            <span data-arabic="إدارة الطلبات"
                  data-english="Order Managment"></span>

        </h1>
        <div>
            <a href="#">
                <i id="infoBtn" class="fa fa-info-circle" style="color:#502e90;"></i>
            </a>
            <div id="infoPopup">On this page, the user can see all additional services and control them by adding a new additional service, modifying an existing additional service, deleting a additional service, or looking at the details of each additional service</div>
        </div>
    </div>

    <form asp-action="Index" method="get" id="searchForm">
        <div class="row" style="margin-left: 20px; margin: 10px;">

            <div class="col-2 ">
                <input 
                    name="Name" 
                    class="form-control form-control-lg" 
                    type="text"
                       placeholder="Salesman Name"
                       aria-label="User Name"
                       style="border-radius: 17px; border: none;">
            </div>
            <div class="col-2 ">
                <input name="Phone"
                       class="form-control form-control-lg" 
                    type="text" 
                    placeholder="Barcode"
                       aria-label="Phone Number"
                       style="border-radius: 17px; border: none;">
            </div>
            
            <div class="col-2 ">
                <input name="Phone"
                       class="form-control form-control-lg"
                       type="text"
                       placeholder="Status"
                       aria-label="Phone Number"
                       style="border-radius: 17px; border: none;">
            </div>

            <input type="hidden" name="PageIndex" id="pageIndex" value="1">

            <div class="col-4 ">

                <button onclick="updatePageIndex(@ViewBag.LastIndex)" class="btn btn-lg new"
                        style="border:2px solid #502e90; color: white;width:150px; border-radius:20px ; padding-left: 35px ; padding-right: 35px;">
                    <span data-arabic="بحث" data-english="Search">
                        
                    </span>
                </button>

                <button type="submit" hidden></button>
                <a asp-action="Index" title="Back to full list"><i class="fa-solid fa-circle-chevron-left fa-xl" style="color:#502e90"></i></a>
            </div>

            <!-- Force next columns to break to new line at md breakpoint and up -->

        </div>
    </form>

</div>
<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- DataTales Example -->
    <div class="card-body ">
        <div class="table-responsive shadow mb-4"
             style="background-color: white; border-radius: 17px; ">
            <table class="table table-bordered " id="dataTable" width="100%" cellspacing="0"
                   style="border: 0px;">
                <thead>
                    <tr>
                        <th data-arabic="رقم الطلب" data-english="Order_Id"></th>
                        <th data-arabic="إسم المندوب" data-english="Salesman Name"></th>
                        <th data-arabic="إسم الزبون" data-english="Customer Name"></th>
                        <th data-arabic="رقم الهاتف" data-english="Phone Number"></th>
                        <th data-arabic="العنوان" data-english="Address"></th>
                        <th data-arabic="الكمية" data-english="Quantity"></th>
                        <th data-arabic="السعر الكلي" data-english="Total Price"></th>
                        <th data-arabic="الحالة" data-english="Status"></th>
                        <th data-arabic="عرض التفاصيل" data-english="View Details"></th>
                    </tr>
                </thead>

                <tbody>
                   @*  @if (Model is not null)
                    { *@


                        @* @if (data.Count > 0 && data != null)
                        { *@

                           @*  @foreach (var item in data)
                            { *@

                                <tr>
                                   
                                    <td>1</td>
                                    <td>حنين</td>
                                    <td>صابرين</td>
                                    <td>0789654123</td>
                                    <td>الاردن</td>
                                    <td>1</td>
                                    <td>15.6</td>
                                    <td>قيد الانتظار</td>

                                  
                                    <td>
                                        <span style="margin: 10px;">
                                            <a asp-action="Details" asp-route-id="1">
                                                <i class="fa fa-info-circle" style="color:#502e90;"></i>

                                            </a>
                                        </span>
                                    </td>
                                </tr>
                                
                            @* } *@

                       @*  }
                        else
                        {
                            <tr style="text-align:center">
                                <td colspan="5" style="font-size:20px;font-style:italic">No Data</td>
                            </tr>
                        } *@
                    @* } *@
                    @* else
                    {
                        <tr style="text-align:center">
                            <td colspan="5" style="font-size:20px;font-style:italic">No Data</td>
                        </tr>
                    } *@

                </tbody>


            </table>
            @if (Model is not null)
            {
                <form method="get" asp-action="Index">


                    <input hidden readonly type="number" id="pagenumber" name="pageIndex" value="@pagenumber" />
                    <input readonly hidden type="number" id="currentPage" min="1" value="1">
                    <div class="pagination" id="pagination">

                        <input hidden readonly type="number" oninput="generatePagination()" id="totalPages" min="1" value="@Page.NumberOfPages">
                    </div>
                </form>


            }
        </div>
    </div>

</div>
@{
    bool inputCondition = ViewBag.Action; // Assuming ViewBag.Action is a boolean value
}

@if (inputCondition == true)
{
    <script src="~/pagesjs/layout/toastmessagejs.js"></script>
}
<script src="~/pagesjs/permission/permissionindex.js"></script>
<script src="~/pagesjs/publicjs/public.js"></script>
<script src="~/pagesjs/pagination/paginationjs.js"></script>
<script src="~/pagesjs/publicjs/popup.js"></script>
