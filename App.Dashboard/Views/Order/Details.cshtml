@using App.Domain.Constants.Enums
@using App.Domain.Orders.Dtos
<link href="~/pagescss/customer/customerdetails.css" rel="stylesheet" />
<link href="~/pagescss/css/public.css" rel="stylesheet" />

@model Muslim.HandelResult.Result<DetailsOrderDto>
@{
    var data = Model.Response;
    var Page = Model.Page;
}

<div id="wrapper" >


    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">

        <!-- Main Content -->
        <div id="content">

            <div class="container-fluid">

                <!-- Page Heading -->
                <div class="d-sm-flex align-items-center justify-content-between mb-4">

                    <h1 class="h3 mb-0 text-gray-800">
                        <i class="fa-solid fa-users-rays" style="color: #0ec0e4;"></i>
                        <span data-arabic="تفاصيل الطلب" data-english="Order Details"></span>
                    </h1>
                </div>
                <hr/>
                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800" style="margin: 10px;">
                        <i class="fa-solid fa-money-check" style="color: #e94e24;"></i>
                        <span data-arabic="معلومات الزبون"
                              data-english="Customer Info"></span>
                    </h1>
                </div>
            </div>

            <div style="margin: 15px;">
                <div class="container "
                     style=" background-color: white; height:450px;  margin-left: 0!important; border-radius: 17px;">


                     
                    <div class="row">

                        <div class="col" style="margin-top: 30px; margin-left: 10px;">

                            <div class="FullNameContainer MarginStyle">
                                <span style="font-weight: bold;" data-arabic="اسم الزبون :" data-english="Customer Name :"></span>
                                <span id="FullName">@data.Clint.Name</span>
                                
                            </div>
                            <div class="PhoneNumberContainer MarginStyle">
                                <span style="font-weight: bold;" data-arabic="رقم الهاتف :" data-english="Phone Number :"></span>
                                <span id="Phone">@data.Clint.Phone</span>
                                
                            </div>

                            <div class="PhoneNumberContainer MarginStyle">
                                <span style="font-weight: bold;" data-arabic="رقم الهاتف البديل :" data-english="Second Phone Number :"></span>
                                <span id="SecandPhone">@data.Clint.SecandPhone</span>
                                
                                
                            </div>
                           
                            <div class="PhoneNumberContainer MarginStyle">
                                <span style="font-weight: bold;" data-arabic="الوزن :" data-english="Weight :"></span>
                                <span id="Weight">@data.Clint.Weight</span>
                                
                            </div>
                            <div class="PhoneNumberContainer MarginStyle">
                                <span style="font-weight: bold;" data-arabic="ألطول :" data-english="Hight :"></span>
                                <span id="Hight">@data.Clint.Hight</span>
                                
                            </div>


                        </div>
                    </div>



                </div>


            </div>


            <h1 class="h3 mb-0 text-gray-800" style="margin: 10px;">
                <i class="fa-solid fa-money-check" style="color: #e94e24;"></i>
                <span data-arabic="المنتجات" data-english="Products"></span>
            </h1>
           

            <div class="container" style="max-width: 100% ; padding: 10px; background-color: white;">
                @foreach (var item in data.Products)
                {

                    <div class="row">
                        <div style="margin-top: 30px;">
                            <img src="@item.Image"
                                 alt="" style="border-radius: 17px; width:250px ;margin: 50px" />
                        </div>

                        <div class="col" style="margin-top: 30px; margin-left: 10px;">

                            <div class="FullNameContainer MarginStyle">
                                <span style="font-weight: bold;" data-arabic="رقم الموديل:" data-english="Model Number :"></span>
                                <span id="Modele">@item.Model</span>
                            </div>

                            <div class="FullNameContainer MarginStyle">
                                <span style="font-weight: bold;" data-arabic="السعر :" data-english="Price :"></span>
                                <span id="Price">@item.Price</span>
                            </div>

                            <div class="FullNameContainer MarginStyle">
                                <span style="font-weight: bold;" data-arabic="الكمية:" data-english="Quantity :"></span>
                                <span id="Quantity">@item.Quantity</span>
                            </div>

                            <div class="FullNameContainer MarginStyle">
                                <span style="font-weight: bold;" data-arabic="ملاحظات :" data-english="Notes :"></span>
                                <span id="Notes">@item.Notes</span>
                            </div>


                        </div>
                </div>

                }
            </div>

           
            <!-- /.container-fluid -->

            <hr />

            <div class="container" style="max-width: 100% ; padding: 10px;background-color: white;">
                <div class="row">
                    <div class="col" style="margin-top: 30px; margin-left: 10px;">
                        <div class="FullNameContainer MarginStyle">
                            <span style="font-weight: bold;" data-arabic="الملاحظات :" data-english="Notes :"></span>
                            <span id="DeliveryFee">@data.Notes</span>
                        </div>
                        <div class="FullNameContainer MarginStyle">
                            <span style="font-weight: bold;" data-arabic="رسوم التوصيل :" data-english="Delivery Fare :"></span>
                            <span id="DeliveryFee">@data.DeliveryFare</span>
                        </div>
                        <div class="FullNameContainer MarginStyle">
                            <span style="font-weight: bold;" data-arabic="السعر الإجمالي :" data-english="Total Price :"></span>
                            <span id="TotalPrice">@data.TotalPrice</span>
                        </div>
                        
                    </div>
                </div>
            </div>

            <h1 class="h3 mb-0 text-gray-800" style="margin: 10px;">
                <i class="fa-solid fa-money-check" style="color: #e94e24;"></i>
                <span data-arabic="الإجرائات" data-english="Actions"></span>
            </h1>
            <div class="container" style="max-width: 100% ; padding: 10px;">
                <div class="row">
                    <div class="col" style="margin-top: 30px; margin-left: 10px;">
                       @* print button *@
                       <button class="btn btn-primary" style="margin: 10px;" onclick="PrintOrder()">
                            <i class="fa-solid fa-print" style="color: white;"></i>
                            <span data-arabic="طباعة" data-english="Print"></span>
                        </button>
                        
                        @* edit status *@
                        @* <div class="dropdown"> *@
                            <button class="btn btn-primary dropdown-toggle" type="button" id="orderStatusDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                @switch (data.OrderStatus)
                                {
                                    case OrderStatus.Accept:
                                        <span data-arabic="مقبول" data-english="Accepted"></span>
                                        break;
                                    case OrderStatus.Reject:
                                        <span data-arabic="مرفوض" data-english="Rejected"></span>
                                        break;
                                    case OrderStatus.Pending:
                                        <span data-arabic="قيد الانتظار" data-english="Pending"></span>
                                        break;
                                    case OrderStatus.Delivered:
                                        <span data-arabic="تم التوصيل" data-english="Delivered"></span>
                                        break;
                                    case OrderStatus.Paid:
                                        <span data-arabic="مدفوع" data-english="Paid"></span>
                                        break;
                                    case OrderStatus.Revoke:
                                        <span data-arabic="مرتجع" data-english="Revoke"></span>
                                        break;
                                }
                            </button>
                            <div class="dropdown-menu" aria-labelledby="orderStatusDropdown">
                                <a class="dropdown-item" href="#" onclick="changeStatus(@Model.Response.Id, '@OrderStatus.Accept')">
                                    <span data-arabic="مقبول" data-english="Accepted"></span>
                                </a>
                                <a class="dropdown-item" href="#" onclick="changeStatus(@Model.Response.Id, '@OrderStatus.Reject')">
                                    <span data-arabic="مرفوض" data-english="Rejected"></span>
                                </a>
                                <a class="dropdown-item" href="#" onclick="changeStatus(@Model.Response.Id, '@OrderStatus.Pending')">
                                    <span data-arabic="قيد الانتظار" data-english="Pending"></span>
                                </a>
                                <a class="dropdown-item" href="#" onclick="changeStatus(@Model.Response.Id, '@OrderStatus.Delivered')">
                                    <span data-arabic="تم التوصيل" data-english="Delivered"></span>
                                </a>
                                <a class="dropdown-item" href="#" onclick="changeStatus(@Model.Response.Id, '@OrderStatus.Paid')">
                                    <span data-arabic="مدفوع" data-english="Paid"></span>
                                </a>
                                <a class="dropdown-item" href="#" onclick="changeStatus(@Model.Response.Id, '@OrderStatus.Revoke')">
                                    <span data-arabic="مرتجع" data-english="Revoke"></span>
                                </a>
                            </div>
                        @* </div> *@

                            

                        



                        
                    </div>
                </div>
            </div>

        </div>


    </div>
    <!-- End of Content Wrapper -->

</div>

<a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
</a>

<div id="customPrintContent" style="display:none">
    <h1>Custom Print Content</h1>
    <p>This is the content that will be printed.</p>
</div>
<script src="~/pagesjs/managestock/customeroperations.js"></script>
<script>
    
    function changeStatus(id, status) 
    {
        $.ajax({
            url: '@Url.Action("ChangeStatus", "Order")',
            method: 'POST',
            data: {
                id: id,
                status: status
            },
            success: function () {
                // Use Swal
             
                    Swal.fire({
                        title: "Success",
                        text: "Status changed successfully",
                        icon: "success",
                        confirmButtonText: "Ok"
                    }).then(() => {
                        location.reload();
                    });
          
                

            },
            error: function (xhr, status, error) {
                console.error('Error changing status:', error);
            }
        });
    }
    
    function PrintOrder() {
        var printContent = document.getElementById('customPrintContent').innerHTML;
        var originalContent = document.body.innerHTML;
        document.body.innerHTML = printContent;
        window.print();
        document.body.innerHTML = originalContent;
    }


    //change dir when change lang
    $(document).ready(function () {
        if (localStorage.getItem('lang') == 'ar') {
            $('body').css('direction', 'rtl');
            $('body').css('text-align', 'right');
        }
        else {
            $('body').css('direction', 'ltr');
            $('body').css('text-align', 'left');
        }
    });

</script>

