@{
    ViewData["Title"] = "InternalServerError";
    Layout = "LayoutError";
}

<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> 500 Error Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>


<body>
    <div class="d-flex align-items-center justify-content-center vh-100">
        <div class="text-center">
            <h1 class="display-1 fw-bold">401</h1>
            <p class="fs-3"> <span class="text-danger">Opps!</span> Unutilized</p>
            <p class="lead">
                The page you're looking for isn't working properly.
            </p>
            <a asp-action="Index" asp-controller="Home" class="btn btn-lg"
               style="background-color: #502e90; color: white; border-radius:20px ; padding-left: 35px ; padding-right: 35px;">Go To Home Page</a>
        </div>
    </div>
</body>


</html>
