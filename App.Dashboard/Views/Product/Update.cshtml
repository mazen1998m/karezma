@using App.Domain.Products.Dtos
<link href="~/pagescss/css/popup.css" rel="stylesheet" />
<link href="~/pagescss/css/public.css" rel="stylesheet" />
<link href="~/pagescss/css/checkboxswitch.css" rel="stylesheet" />
@model Result<UpdateProductDto>
@{
    var data = Model.Response;
    var Page = Model.Page;
}
<form asp-action="Update" method="post">
    <!-- Begin Page Content -->
    <div class="container-fluid">

        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">

            <h1 class="h3 mb-0 text-gray-800">
                <i class="fa-solid fa-pen" style="color: #0ec0e4"></i>
                <span data-arabic="تعديل منتج" data-english="Update Product"></span>
            </h1>
           @*  <div>
                <a href="#">
                    <i id="infoBtn" class="fa fa-info-circle" style="color:#502e90;"></i>
                </a>
                <div id="infoPopup">
                    <span 
                        data-arabic="في هذه الصفحة يمكنك تحديث معلومات المنتج" 
                        data-english="On this page, you can modify the product"></span>
                </div>
            </div> *@
        </div>

        <input asp-for="@data.Id" name="Id" type="hidden"/>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-arabic="اسم المنتج"
                   data-english="Product Name"></label>

            <input class="form-control form-control-lg"
                   required
                   asp-for="@data.Name"
                   name="Name"
                   type="text"
                   placeholder-ar="اسم المنتج"
                   placeholder-en="Product Name"
                   aria-label="Name"
                   style="border-radius: 17px; border: none;"
                   propertyName="Name"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-arabic="الموديل"
                   data-english="Model"></label>

            <input class="form-control form-control-lg"
                   required
                   asp-for="@data.Model"
                   name="Model"
                   type="text"
                   placeholder-ar="الموديل"
                   placeholder-en="Model"
                   aria-label="Model"
                   style="border-radius: 17px; border: none;"
                   propertyName="Model"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-arabic="ألباركود"
                   data-english="Barcode Number"></label>

            <input class="form-control form-control-lg"
                   asp-for="@data.Barcode"
                   name="Barcode"
                   type="text"
                   placeholder-ar="ألباركود"
                   placeholder-en="Barcode"
                   aria-label="Barcode"
                   style="border-radius: 17px; border: none;"
                   propertyName="Barcode"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-arabic="الوصف"
                   data-english="Description "></label>

            <textarea class="form-control form-control-lg"
                      asp-for="@data.Description"
                      name="Description"
                      placeholder-ar="الوصف"
                      placeholder-en="Description"
                      aria-label="Description"
                      style="border-radius: 17px; border: none;"
                      propertyName="Description"
                      validation="@(Json.Serialize(Model.ValidatorError).ToString())"></textarea>

        </div>

        @* add img  *@

        <div style="margin-top: 30px;">
            <img src="~/img/product-img/@(data.Image)"
                 alt="" style="border-radius: 17px; width:250px ;margin: 50px" />
        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-english="Image"
                   data-arabic="صورة"></label>

            <input type="file" id="imageInput" name="imageInput" accept="image/*" style="display: none;" onchange="handleFileSelect(event)" />
            <input type="hidden" id="imageData" name="ImageBase64" />
            <input type="hidden" asp-for="@data.Image" name="Image">

            <div class="input-group mb-3">
                <input disabled 
                       type="text" 
                       class="form-control" 
                       id="file-name" 
                       placeholder="Choose file" 
                       placeholder-ar="اختر صورة"
                       placeholder-en="Choose Image"
                       aria-label="Choose file" 
                       aria-describedby="button-addon2" 
                       style="border-radius: 17px; border: none;">

                <div class="input-group-append">
                    <button class="btn btn-outline-secondary" type="button" id="button-addon2" onclick="document.getElementById('imageInput').click();" style="border-radius: 17px; border: none; background-color: #502e90; color: white;">Choose</button>
                </div>
            </div>


        </div>

     

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">

            <!-- HTML -->
            <div class="form-check form-switch">
                <span data-arabic="الحالة" data-english="Status"></span>
                <div class="checkbox-wrapper-22">
                    <label class="switch" for="isActiveSwitch">
                        <input class="checkbox-wrapper-22"
                               type="checkbox"
                               aria-label="IsActive"
                               asp-for="@data.IsActive"
                               name="IsActive"
                               id="isActiveSwitch"
                              >
                        <div class="slider round"></div>a
                    </label>

                </div>

            </div>





        </div>

        
    </div>

    <div class="container" style="margin-top:70px">
        <div class="row">
            <div class="col-8"></div>
            <div class="col-4" style=" justify-content: end; text-align: end;">
                <button type="submit" class="btn  btn-lg new"
                        style=" color: white; border-radius:20px ;border:2px solid #502e90; padding-left: 35px;height: auto ; padding-right: 35px; margin-top: -110px;">
                    <span data-arabic="تحديث" data-english="Update"></span>
                </button>

            </div>
        </div>
    </div>
</form>
<script src="~/js/validation.js"></script>
<script src="~/pagesjs/publicjs/popup.js"></script>

<script>
    function handleFileSelect(event) {
        var input = event.target;
        var file = input.files[0];
        document.getElementById("file-name").value = file.name;

        if (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var imageData = e.target.result;
                document.getElementById("imageData").value = imageData;
            };
            reader.readAsDataURL(file);
        }
    }
</script>