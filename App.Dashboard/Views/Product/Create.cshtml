@using App.Domain.Representatives.Dtos
@model Muslim.HandelResult.Result<RepresentativeCreateDto>
@{
    var data = Model.Response;
    var Page = Model.Page;
}
<link href="~/pagescss/css/public.css" rel="stylesheet" />
<link href="~/pagescss/css/popup.css" rel="stylesheet" />

<form asp-action="Create" method="post">
    <!-- Begin Page Content -->
    <div class="container-fluid">

        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">

            <h1 class="h3 mb-0 text-gray-800">
                <i class="fa-regular fa-rectangle-list" style="color: #e94e24"></i>
                <span data-english="Add Product" data-arabic="اضافة منتج"></span>
            </h1>
            <div>
                <a href="#">
                    <i id="infoBtn" class="fa fa-info-circle" style="color:#502e90;"></i>
                </a>
                <div id="infoPopup">On this page, the user adds new additional services </div>
            </div>
        </div>
        
        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-english="Product Name"
                   data-arabic="إسم منتج"></label>

            <input class="form-control form-control-lg"
                   asp-for="@data.UserName"
                   name="Name"
                   type="text"
                   placeholder="Product Name"
                   aria-label="Name"
                   style="border-radius: 17px; border: none;"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-arabic="رقم الموديل"
                   data-english="Model Number"></label>

            <input class="form-control form-control-lg"
                   asp-for="@data.Password"
                   name="Password"
                   type="text"
                   placeholder="Model Number"
                   aria-label="Password"
                   style="border-radius: 17px; border: none;"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-english="Barcod Number"
                   data-arabic="الباركود"></label>

            <input class="form-control form-control-lg"
                   asp-for="@data.Phone"
                   name="Phone"
                   type="text"
                   placeholder="Barcod Number"
                   aria-label="Phone"
                   style="border-radius: 17px; border: none;"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-arabic="الوصف"
                   data-english="Description "></label>

            <textarea required class="form-control form-control-lg"
                      asp-for="@data.Commision"
                      name="Commision"
                      placeholder="Description"
                      aria-label="Commision"
                      style="border-radius: 17px; border: none;"
                      validation="@(Json.Serialize(Model.ValidatorError).ToString())"></textarea>

        </div>

        @* add img  *@


        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-english="Image"
                   data-arabic="صورة"></label>

            <input class="form-control form-control-lg"
              
                   name="Image"
                   type="file"
                   accept="image/*"
                   aria-label="Image"
                   style="border-radius: 17px; border: none;"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>


    </div>

    <div class="container" style="margin-top:70px">
        <div class="row">
            <div class="col-8"></div>
            <div class="col-4" style=" justify-content: end; text-align: end;">
                <button type="submit" class="btn  btn-lg new" @* onclick="validatePassword()" *@
                        style=" color: white; border-radius:20px ;border:2px solid #502e90; padding-left: 35px ; padding-right: 35px; margin-top: -110px;">
                    <span data-english="Add Product" data-arabic="اضافة منتج">
                      
                    </span>
                </button>

            </div>
        </div>
    </div>
</form>

<script src="~/js/validation.js"></script>  
<script src="~/pagesjs/publicjs/popup.js"></script>