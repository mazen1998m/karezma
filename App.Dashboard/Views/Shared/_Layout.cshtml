@using App.Dashboard.Controllers
@using Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>Dihliz App</title>
    <!-- Custom fonts for this template-->
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">
    <!-- Custom styles for this template-->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/7ff406674c.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/parsley.js/2.9.2/parsley.min.js"></script>
    <script src="https://d3js.org/d3.v4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/billboard.js/dist/billboard.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/billboard.js/dist/billboard.min.css" />
    <link rel="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css" type="text/css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js">
    </script>
 
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/1.0.1/Chart.min.js">
    </script>
    <script src="https://kit.fontawesome.com/7ff406674c.js" crossorigin="anonymous"></script>
    <script src="https://polyfill.io/v3/polyfill.min.js?features=default"></script>
    


    <link href="~/pagescss/css/toastmessagecss.css" rel="stylesheet" />
    <link href="~/pagescss/layout/layout.css" rel="stylesheet" />
</head>

@{

    var controllerName = string.Empty;
    object controllerObj;

    if (ViewContext.RouteData.Values.TryGetValue("controller", out controllerObj))
    {
        controllerName = controllerObj.ToString();
    }

}
<style>
    /* Base Style */
    .custom-select2 {
        /* position: relative; */
        /* display: inline-block; */
        background-color: transparent;
        border: 1px solid #502e90;
        border-radius: 5px;
        padding: 10px;
        cursor: pointer;
        color: #502e90;
    }

        .custom-select2  option {
            /* background-color: #fff !important; */
            background-color: transparent !important;
            color: #502e90  !important;
        }

        /* Disabled state */
        .custom-select2 select:disabled {
            opacity: 0.6 !important; 
            cursor: not-allowed !important;
        }

</style>
<style>
    body {
        font-family: Arial, sans-serif;
    }

    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: currentcolor;
        padding: 10px;
        color: white;
        margin-bottom: 20px;
    }

        .navbar .dropdown {
            position: relative;
            display: inline-block;
        }

        .navbar .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 1;
            margin-top: 2px;
            margin-left: -67px;
            margin-right: -90px;
        }

            .navbar .dropdown-content a {
                color: black;
                padding: 12px 16px;
                text-decoration: none;
                display: block;
            }

                .navbar .dropdown-content a:hover {
                    background-color: #f1f1f1;
                }

        .navbar .dropdown:hover .dropdown-content {
            display: block;
        }

        .navbar .dropdown:hover .dropbtn {
            background-color: #3e8e41;
        }

    .user-profile {
        display: flex;
        align-items: center;
    }

        .user-profile img {
            border-radius: 50%;
            margin-right: 10px;
        }
</style>
<body id="page-top" style="background-color:#F8F9FC;">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <div id="navbar" @if (controllerName == "Home") { <text>style="display:none;"</text> }>


            <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" style="height: 120rem; background-color: #502e90; background-image: linear-gradient(180deg, #502e90 10%, #502e90 10%, #502e90 100%) !important;" id="accordionSidebar">

                <!-- Sidebar - Brand -->
                <a class="sidebar-brand d-flex align-items-center justify-content-center" asp-action="Index" asp-controller="Home"
                   style="margin-bottom: 20px; margin-top: 20px;background-color:#502e90;background-image: linear-gradient(180deg, #502e90 10%, #502e90 10%, #502e90 100%) !important;">
                    <img src="~/img/carismaLogo.svg" alt="" width="100px" >
                </a>

                @if (controllerName == "Representative")
                {
                    <div class="sidebar-heading" style="margin-top: 10px;"></div>

                    <hr class="sidebar-divider my-0" />
 
                    <li class="nav-item bgDarkItem">
                       <a  asp-controller="Representative" asp-action="Index">
                          <i class="fa-solid fa-magnifying-glass" style="color: #e94e24 "></i>
                           <span  data-english="Salesmen Managment" data-arabic="إدارة المندوبين"></span>
                       </a>
                    </li>

                    <li class="nav-item bgDarkItem">
                        <a  asp-controller="Representative" asp-action="Create">
                            <i class="fa-solid fa-user-plus" style="color: #e94e24"></i>
                                    <span  data-english="Add Salesmen" data-arabic="إضافة المندوب"></span>
                        </a>
                    </li>
                           
                   
                }
                @if (controllerName == "Product")
                {
                     <div class="sidebar-heading" style="margin-top: 10px;"></div>
                     
                     <hr class="sidebar-divider my-0" />
                    
                     <li class="nav-item bgDarkItem">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <i class="fa-solid fa-magnifying-glass" style="color: #e94e24 "></i>
                            <span  data-english="Products Managment" data-arabic="إدارة المنتجات"></span>
                        </a>
                     </li>

                     <li class="nav-item bgDarkItem">
                         <a class="nav-link" asp-controller="Product" asp-action="Create">
                            <i class="fa-solid fa-user-plus" style="color: #e94e24"></i>
                            <span  data-english="Add Product" data-arabic="إضافة منتج"></span>
                         </a>
                     </li>
                   
                }
                @if (controllerName == "Order")
                {
                    <div class="sidebar-heading" style="margin-top: 10px;"></div>

                    <hr class="sidebar-divider my-0" />
    
                    <li class="nav-item bgDarkItem">
                        <a class="nav-link" asp-controller="Order" asp-action="Index">
                            <i class="fa-solid fa-magnifying-glass" style="color: #e94e24 "></i>
                            <span  data-english="Order Managment" data-arabic="إدارة الطلبات"></span>
                        </a>
                    </li>
                }
            </ul>
            <!-- Default navbar content -->
        </div>

        <div id="content-wrapper" class="d-flex flex-column">


            <!-- Main Content -->
            <div id="content">
                @if (controllerName == "Home")
                {
                    <nav class="navbar" style="background-color:#502e90">

                        <div class="dropdown" style="display: flex; justify-content: space-between;">
                            <div class="col-1">
                                <a asp-action="Index" asp-controller="Home">
                                    <img src="~/img/carismaLogo.svg" alt="" width="80px">
                                </a>
                            </div>
                            <select id="languageSelector" class="custom-select2" style="color:white;border-color:white;">
                                <option value="en">English</option>
                                <option value="ar">العربية</option>
                            </select>
                        </div>
                        <div class="user-profile">
                            <img src="~/img/user-icon.jpg" width="40" height="40">
                            <div class="dropdown">
                                <button class="dropbtn" style="background:none;border:none;color:white;">Khaled</button>
                                <div class="dropdown-content">
                                    <a href="#">Change Password</a>
                                    <a class="dropdown-item" data-toggle="modal" style="cursor: pointer;" data-target="#logoutModal">
                                        <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                        Logout
                                    </a>
                                </div>
                            </div>
                        </div>

                    </nav>
                }
                else
                {
                    <nav class="navbar">
                        <div class="dropdown">
                            <select id="languageSelector" class="custom-select2" >
                                <option value="en">English</option>
                                <option value="ar">العربية</option>
                            </select>
                        </div>
                        <div class="user-profile">
                            <img src="~/img/user-icon.jpg"  width="40" height="40">
                            <div class="dropdown">
                                <button class="dropbtn" style="background:none;border:none;">Khaled</button>
                                <div class="dropdown-content">
                                    <a href="#">Change Password</a>
                                    <a class="dropdown-item" data-toggle="modal" style="cursor: pointer;" data-target="#logoutModal">
                                        <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                        Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                    </nav>

                }

                @RenderBody()
             

             </div>

            <!-- Footer -->
            <footer class="b">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span></span>
                    </div>
                </div>
            </footer>
        </div>

        <!-- End of Footer -->
    </div>
    
    
    <a class="scroll-to-top rounded" style="background-color:#502e90" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn " style="background-color:#0ec0e4;color:#fff" type="button" data-dismiss="modal">Cancel</button>
                    <form asp-action="Logout" asp-controller="Auth" method="post"><button type="submit" class="btn " style="background-color:#e94e24;color:#fff">Logout</button></form>

                </div>
            </div>
        </div>
    </div>







    <!-- Bootstrap core JavaScript-->
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <!-- Custom scripts for all pages-->
    <script src="~/js/sb-admin-2.min.js"></script>
    <script src="~/pagesjs/layout/layout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/js/bootstrap.min.js"></script>
    
    <script>
        $(document).ready(function () {
            // Restore selected language from localStorage
            const savedLanguage = localStorage.getItem('selectedLanguage');
            if (savedLanguage) {
                $('#languageSelector').val(savedLanguage);
            }

            // Initial language setup
            changeLanguage();

            // Language change event
            $('#languageSelector').change(function () {
                const selectedLanguage = $(this).val();
                localStorage.setItem('selectedLanguage', selectedLanguage);
                changeLanguage();
            });

            function changeLanguage() {
                const selectedLanguage = $('#languageSelector').val();
                $('[data-arabic]').each(function () {
                    $(this).text(selectedLanguage === 'ar' ? $(this).data('arabic') : $(this).data('english'));
                });
                
                document.querySelectorAll(("input[placeholder-ar]"))
                    .forEach(element => {
                        
                        element.placeholder = selectedLanguage === 'ar' ? element.getAttribute('placeholder-ar') : element.getAttribute('placeholder-en');
                    });

                //add direction: rtl to body
                if (selectedLanguage === 'ar') {
                    document.body.style.direction = 'rtl';
                } else {
                    document.body.style.direction = 'ltr';
                }
            }
        });
    </script>

</body>

</html>