@using App.Domain.Users.Auths;
@model LoginRequest;
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutLogin";

    // Check if there is an authentication error message
    string errorMessage = ViewBag.ErrorMessage as string;
}
<link href="~/pagescss/css/public.css" rel="stylesheet" />
<form class="user" asp-action="Login">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <div class="form-group">
        <input type="text" asp-for="@Model.Email" class="form-control form-control-user"
               id="exampleInputEmail" aria-describedby="emailHelp" style="border:2px solid #502e90"
               placeholder="UserName" required>
    </div>
    <div class="form-group">
        <input type="password" asp-for="@Model.Password" class="form-control form-control-user"
               id="exampleInputPassword" placeholder="Password" style="border:2px solid #502e90" required>
    </div>
    
    <button type="submit" class="btn  btn-user btn-block new" style="width:345px;border:2px solid #502e90">
        <span data-arabic="تسجيل الدخول" data-english="Login"></span>
    </button>
</form>
