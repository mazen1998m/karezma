@using App.Domain.Users.Auths;
@model LoginRequest;
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutLogin";
    string errorMessage = ViewBag.ErrorMessage as string;
}
<link href="~/pagescss/css/public.css" rel="stylesheet" />

<style>
    #togglePassword {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #502e90;  
    }

    style=""
  
</style>

<form class="user" asp-action="Login" style="width: 60%;">
    
    <div class="text-center">
        <h1 class="h4 text-gray-900 mb-4"
            data-arabic="! اهلا بك " data-english="Welcome Back!"></h1>
    </div>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <div class="form-group">
        <input 
            type="text" 
            asp-for="@Model.Email" 
            class="form-control form-control-user"   
            id="exampleInputEmail" 
            aria-describedby="emailHelp" 
            style="border:2px solid #502e90"
            placeholder-ar="اسم المستخدم"
            placeholder-en="UserName"
            required>
    </div>
    <div class="form-group" style="position: relative;">
        <input type="password"
               id="password"
               asp-for="@Model.Password"
               class="form-control form-control-user"
               style="border:2px solid #502e90; padding-right: 40px;"
               placeholder-ar="كلمة المرور"
               placeholder-en="Password"
               data-password-toggle="true"
               required>
        <span class="fa fa-eye-slash" id="togglePassword"> </span>
    </div>

            
            
    
    <button type="submit" class="btn  btn-user btn-block new" style="width:100%;border:2px solid #502e90">
        <span data-arabic="تسجيل الدخول" data-english="Login"></span>
    </button>
</form>
