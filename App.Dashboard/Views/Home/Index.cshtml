<!-- Other HTML code above this -->

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Get the input element
        var searchInput = document.getElementById("searchInput");



        // Add event listener for input changes
        searchInput.addEventListener("input", function () {
            // Get the value entered in the search input
            var searchValue = searchInput.value.toLowerCase();

            // Get all the cards on the page
            var cards = document.querySelectorAll(".card");
            console.log(cards);

            // Loop through each card to check if it contains the search value in the name (assumed in the first <p> tag)
            cards.forEach(function (card) {
                // Get the text content of the first <p> tag within the card
                var cardName = card.querySelector("p").textContent.toLowerCase();

                // Show or hide the card based on whether it contains the search value in the name
                if (cardName.includes(searchValue)) {
                    card.style.display = "block";
                } else {
                    card.style.display = "none";
                }
            });
        });
    });
</script>

@{
    bool inputCondition = ViewBag.Action; // Assuming ViewBag.Action is a boolean value
}

@if (inputCondition == true)
{
    <script src="~/pagesjs/layout/toastmessagejs.js"></script>
