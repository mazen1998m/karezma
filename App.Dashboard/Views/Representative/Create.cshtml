@using App.Domain.Representatives.Dtos
@model Muslim.HandelResult.Result<CreateRepresentativeDto>
@{
    var data = Model.Response;
    var Page = Model.Page;
}
<link href="~/pagescss/css/public.css" rel="stylesheet" />
<link href="~/pagescss/css/popup.css" rel="stylesheet" />

<form asp-action="Create" method="post">
    <!-- Begin Page Content -->
    <div class="container-fluid">

        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">

            <h1 class="h3 mb-0 text-gray-800">
                <i class="fa-regular fa-rectangle-list" style="color: #e94e24"></i>
                <span data-english="Add Salesmen" data-arabic="اضافة مندوب"></span>
            </h1>
            <div>
                <a href="#">
                    <i id="infoBtn" class="fa fa-info-circle" style="color:#502e90;"></i>
                </a>
                <div id="infoPopup">On this page, the Salesmen adds new additional services </div>
            </div>
        </div>
        
        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-english="UserName"
                   data-arabic="إسم المستخدم"></label>

            <input class="form-control form-control-lg"
                   required
                   asp-for="@data.UserName"
                   name="Response.UserName"
                   type="text"
                   placeholder-ar="اسم المستخدم"
                   placeholder-en="UserName"
                   aria-label="UserName"
                   style="border-radius: 17px; border: none;"
                   propertyName="UserName"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-english="Salesmen Name"
                   data-arabic="إسم المندوب"></label>

            <input class="form-control form-control-lg"
                   required
                   asp-for="@data.Name"
                   name="Response.Name"
                   type="text"
                   placeholder-ar="اسم المندوب"
                   placeholder-en="Salesmen Name"
                   aria-label="Name"
                   style="border-radius: 17px; border: none;"
                   propertyName="Name"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-arabic="كلمة المرور"
                   data-english="Password"></label>

            <input class="form-control form-control-lg"
                   required
                   asp-for="@data.Password"
                   name="Response.Password"
                   type="password"
                   placeholder-ar="كلمة المرور"
                   placeholder-en="Password"
                   aria-label="Password"
                   style="border-radius: 17px; border: none;"
                   propertyName="Password"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-english="Phone Number"
                   data-arabic="رقم الهاتف"></label>

            <input class="form-control form-control-lg"
                   required    
                   asp-for="@data.Phone"
                   name="Response.Phone"
                   type="text"
                   placeholder-ar="رقم الهاتف"
                   placeholder-en="Phone Number"
                   aria-label="Phone"
                   style="border-radius: 17px; border: none;"
                   propertyName="Phone"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>

        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-arabic="العمولة"
                   data-english="Commission"></label>

            <input class="form-control form-control-lg"
                   required
                   type="number"
                   step="0.01"
                   asp-for="@data.Commision"
                   name="Response.Commision"
                   placeholder-ar="العمولة"
                   placeholder-en="Commission"
                   aria-label="Commision"
                   style="border-radius: 17px; border: none;"
                   propertyName="Commision"
                   validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>


    </div>

    <div class="container" style="margin-top:70px">
        <div class="row">
            <div class="col-8"></div>
            <div class="col-4" style=" justify-content: end; text-align: end;">
                <button type="submit" class="btn  btn-lg new" @* onclick="validatePassword()" *@
                        style=" color: white; border-radius:20px ;border:2px solid #502e90; padding-left: 35px ; padding-right: 35px; margin-top: -110px;">
                    <span data-english="Add Salesmen" data-arabic="اضافة مندوب">
                      
                    </span>
                </button>

            </div>
        </div>
    </div>
</form>

<script src="~/js/validation.js"></script>
<script src="~/pagesjs/publicjs/popup.js"></script>