@using App.Domain.Users.Auths
@model Result<ResetPassword>;
@{
    var data= Model.Response;
}
<link href="~/css/sb-admin-2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://polyfill.io/v3/polyfill.min.js?features=default"></script>
<link href="~/pagescss/css/public.css" rel="stylesheet" />

<form asp-action="ResetPassword">
    <!-- Begin Page Content -->
    <div class="container-fluid">

        <!-- Page Heading -->
        <div class="d-sm-flex align-items-center justify-content-between mb-4">

            <h1 class="h3 mb-0 text-gray-800">
                <i class="fa-solid fa-lock" style="color: #e94e24;"></i>
                <span data-english="Reset Password"
                      data-arabic="إعادة تعيين كلمة المرور"></span>
            </h1>
        </div>
        <div hidden class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;">Id</label>

            <input 
                readonly 
                required
                asp-for="@data.Id"
                type="text"
                name="Response.Id"
                class="form-control form-control-lg" 
                placeholder="Id" aria-label="Id"
                style="border-radius: 17px; border: none;"
                >


        </div>
  
        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label 
                style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-english="Password"
                   data-arabic="كلمة المرور"></label>
            <input 
                id="password" 
                required 
                asp-for="@data.NewPassword"
                name="Response.NewPassword"
                type="password" 
                class="form-control form-control-lg" 
                placeholder-ar="كلمة المرور"
                placeholder-en="Password"
                aria-label="Password" 
                style="border-radius: 17px; border: none;"
                propertyName="NewPassword"
                validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>
        <div class="row" style="margin-left: 20px; margin: 10px;  max-width: 60%;">
            <label style="font-weight: bold; color: black; margin-top:0px; margin-left: 25px;"
                   data-english="Confirm Password"
                   data-arabic="تاكيد كلمة المرور"></label>
            <input 
                id="confirmPassword" 
                required 
                asp-for="@data.ConfirmPassword"
                name="Response.ConfirmPassword"
                type="password" 
                class="form-control form-control-lg" 
                placeholder-ar="تاكيد كلمة المرور"
                placeholder-en="Confirm Password"
                aria-label="Confirm Password" 
                style="border-radius: 17px; border: none;"
                propertyName="ConfirmPassword"
                validation="@(Json.Serialize(Model.ValidatorError).ToString())">

        </div>
        <div class="container" style="margin-top:70px">
            <div class="row">
                <div class="col-8"></div>
                <div class="col-4" style=" justify-content: end; text-align: end;">
                    <button type="submit" class="btn  btn-lg new"
                            style=" color: white; border-radius:20px ;border:2px solid #502e90; padding-left: 35px ; padding-right: 35px; margin-top: -110px;">
                        <span data-english="Save"
                              data-arabic="حفظ">
                            
                        </span>
                    </button>

                </div>
            </div>
        </div>
    </div>
</form>

<script src="~/js/validation.js"></script>
<script src="~/pagesjs/user/resetpassword.js"></script>

